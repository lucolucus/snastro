-- Queries for `riassunto` — schema in migrations/7.sqm (ADR 0034, ADR 0022, ADR 0006 Amendment (a)).
-- TRANSITION (ADR 0033 §6, removed by incontro-chiavi): the domain still carries a registrazione_id, so the
-- Incontro is resolved from it by SQL join and rows are projected back with the Parte's registrazione_id; the
-- stored `struttura` carries the '<registrazioneId>=' prefix of ADR 0034 §1, added and stripped by the repository.

trovaPerId:
SELECT r.id, g.id AS registrazione_id, r.stato, r.argomento, r.lunghezza_massima_parole, r.richiesto_alle, r.avviato_alle,
    r.motivo_fallimento, r.sommario, r.omessi, r.struttura
FROM riassunto AS r INNER JOIN registrazione AS g ON g.incontro_id = r.incontro_id
WHERE r.id = :id;

trovaDiRegistrazione:
SELECT r.id, g.id AS registrazione_id, r.stato, r.argomento, r.lunghezza_massima_parole, r.richiesto_alle, r.avviato_alle,
    r.motivo_fallimento, r.sommario, r.omessi, r.struttura
FROM riassunto AS r INNER JOIN registrazione AS g ON g.incontro_id = r.incontro_id
WHERE g.id = :registrazioneId ORDER BY r.richiesto_alle, r.id;

-- ADR 0022 §4 / ADR 0023: FIFO order of the shared queue.
trovaInAttesa:
SELECT r.id, g.id AS registrazione_id, r.stato, r.argomento, r.lunghezza_massima_parole, r.richiesto_alle, r.avviato_alle,
    r.motivo_fallimento, r.sommario, r.omessi, r.struttura
FROM riassunto AS r INNER JOIN registrazione AS g ON g.incontro_id = r.incontro_id
WHERE r.stato = 'in_attesa' ORDER BY r.richiesto_alle, r.id;

trovaInCorso:
SELECT r.id, g.id AS registrazione_id, r.stato, r.argomento, r.lunghezza_massima_parole, r.richiesto_alle, r.avviato_alle,
    r.motivo_fallimento, r.sommario, r.omessi, r.struttura
FROM riassunto AS r INNER JOIN registrazione AS g ON g.incontro_id = r.incontro_id
WHERE r.stato = 'in_corso' ORDER BY r.richiesto_alle, r.id;

inserisci:
INSERT INTO riassunto(id, incontro_id, stato, argomento, lunghezza_massima_parole, richiesto_alle,
    avviato_alle, motivo_fallimento, sommario, omessi, struttura)
VALUES (:id, (SELECT incontro_id FROM registrazione WHERE id = :registrazioneId), :stato, :argomento, :lunghezzaMassimaParole, :richiestoAlle,
    :avviatoAlle, :motivoFallimento, :sommario, :omessi, :struttura);

-- A46: the queue's claim, in_attesa -> in_corso, IS its own CAS — the unique index only stops a second
-- non-pronto row of the same Incontro, never two claims racing the SAME id. Correctness rests on
-- the single-consumer queue (avvio-coda-condivisa) in production; this guard is the cheap defensive
-- backstop RiassuntoRepositorySql.aggiornaRadiceEsistente's own `check(righe == 1L)` (A83) relies on.
avvia:
UPDATE riassunto SET stato = 'in_corso', avviato_alle = :avviatoAlle WHERE id = :id AND stato = 'in_attesa';

-- ADR 0022 §4 step 3 (INV-S8): the CAS half of completion — 0 affected rows iff the id is absent, or
-- no longer in_corso (already completed, or every Riassunto of the Incontro was purged meanwhile).
concludi:
UPDATE riassunto SET stato = :stato, motivo_fallimento = :motivoFallimento, sommario = :sommario,
    omessi = :omessi, struttura = :struttura
    WHERE id = :id AND stato = 'in_corso';

-- Single-row removal: the caller deletes riassunto_fonte then riassunto_elemento first (no cascade).
elimina:
DELETE FROM riassunto WHERE id = :id;

-- ADR 0020 / ADR 0022: every Riassunto of the Incontro of a Registrazione (TrascrittoSostituito, RegistrazioneEliminata).
-- The caller deletes riassunto_fonte then riassunto_elemento (their eliminaDiRegistrazione) first.
eliminaDiRegistrazione:
DELETE FROM riassunto WHERE incontro_id = (SELECT incontro_id FROM registrazione WHERE id = :registrazioneId);
