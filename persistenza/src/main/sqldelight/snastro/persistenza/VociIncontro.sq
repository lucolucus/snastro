-- The root ceases with the last Parte that has a Trascritto.
eliminaSeSenzaTrascritti:
DELETE FROM voci_incontro
WHERE incontro_id = (SELECT incontro_id FROM registrazione WHERE id = :registrazioneId)
    AND NOT EXISTS (
        SELECT 1 FROM trascritto AS t INNER JOIN registrazione AS r ON r.id = t.registrazione_id
        WHERE r.incontro_id = voci_incontro.incontro_id AND t.registrazione_id <> :registrazioneId
