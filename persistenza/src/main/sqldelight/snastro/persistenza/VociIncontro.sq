-- Queries for `voci_incontro` — schema in migrations/7.sqm (ADR 0034). Written ONLY by the Trascrizione adapter.
-- Keyed by incontro_id directly (ADR 0033 §4.1): the caller resolved it, no query reads `registrazione`.

trovaPerIncontro:
SELECT incontro_id, prossima_voce FROM voci_incontro WHERE incontro_id = :incontroId;

inserisci:
INSERT INTO voci_incontro(incontro_id, prossima_voce) VALUES (:incontroId, :prossimaVoce);

aggiorna:
UPDATE voci_incontro SET prossima_voce = :prossimaVoce WHERE incontro_id = :incontroId;

-- The root ceases once the Incontro has no Voce left (a Trascritto always has one, so: with its last Trascritto).
eliminaSeSenzaVoci:
DELETE FROM voci_incontro
WHERE incontro_id = :incontroId AND NOT EXISTS (SELECT 1 FROM voce_incontro WHERE incontro_id = :incontroId);
