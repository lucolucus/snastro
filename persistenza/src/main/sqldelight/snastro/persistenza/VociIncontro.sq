-- Queries for `voci_incontro` — schema in migrations/7.sqm (ADR 0034). Written ONLY by the Trascrizione adapter.
-- Transition (ADR 0033 §6): the Incontro is resolved from registrazione_id by SQL join.

trovaDiRegistrazione:
SELECT v.incontro_id, v.prossima_voce
FROM voci_incontro AS v INNER JOIN registrazione AS r ON r.incontro_id = v.incontro_id
WHERE r.id = :registrazioneId;

