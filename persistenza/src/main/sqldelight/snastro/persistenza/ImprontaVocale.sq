-- Queries for `impronta_vocale` — schema in migrations/1.sqm (ADR 0006 Amendment (a)).
-- registraImpronta's "insert or replace" semantics use `sostituisci`, never touching the other
-- prints of the same Parlante. `aggiornaCompareAndSet` is the ONLY write `RiallineaImpronte` uses —
-- an UPDATE of the one row, never an INSERT ("no resurrection": a row purged meanwhile cannot be
-- re-created by after-commit work that started before the purge).

trovaDiParlante:
SELECT * FROM impronta_vocale WHERE parlante_id = :parlanteId;

-- AC-267: metadata only (no BLOB) — every print of a Registrazione, across every Parlante (a
-- P->Q re-attribution can briefly leave v's print on both within one transaction).
metadatiDiRegistrazione:
SELECT parlante_id, registrazione_id, voce_id, sorgente_impronta, modello_impronta
FROM impronta_vocale WHERE registrazione_id = :registrazioneId;

-- AC-267: metadata only (no BLOB) — every print owned by any Parlante of a Progetto.
metadatiDelProgetto:
SELECT iv.parlante_id, iv.registrazione_id, iv.voce_id, iv.sorgente_impronta, iv.modello_impronta
FROM impronta_vocale AS iv
INNER JOIN parlante AS p ON p.id = iv.parlante_id
WHERE p.progetto_id = :progettoId;

inserisci:
INSERT INTO impronta_vocale(parlante_id, registrazione_id, voce_id, impronta, sorgente_impronta, modello_impronta)
VALUES (:parlanteId, :registrazioneId, :voceId, :impronta, :sorgenteImpronta, :modelloImpronta);

sostituisci:
INSERT OR REPLACE INTO impronta_vocale(parlante_id, registrazione_id, voce_id, impronta, sorgente_impronta, modello_impronta)
VALUES (:parlanteId, :registrazioneId, :voceId, :impronta, :sorgenteImpronta, :modelloImpronta);

-- AC-267: compare-and-set UPDATE of the ONE row — no INSERT branch, ever (no resurrection).
-- affectedRows() == 0 iff the row was removed or its sorgente/modello moved on since it was read.
aggiornaCompareAndSet:
UPDATE impronta_vocale
SET impronta = :impronta, sorgente_impronta = :sorgenteImpronta, modello_impronta = :modelloImpronta
WHERE parlante_id = :parlanteId AND registrazione_id = :registrazioneId AND voce_id = :voceId
    AND sorgente_impronta = :sorgenteAttesa AND modello_impronta = :modelloAtteso;

eliminaPerVoceRef:
DELETE FROM impronta_vocale WHERE parlante_id = :parlanteId AND registrazione_id = :registrazioneId AND voce_id = :voceId;

eliminaDiParlante:
DELETE FROM impronta_vocale WHERE parlante_id = :parlanteId;
