-- Queries for `trascritto` — schema in migrations/1.sqm (ADR 0006 Amendment (a)).

-- trascritto.prossima_voce is retired (ADR 0034 §2): the Voce counter is voci_incontro's (VociIncontro.sq).
trovaPerRegistrazione:
SELECT registrazione_id, prossimo_segmento FROM trascritto WHERE registrazione_id = :registrazioneId;

esistePerRegistrazione:
SELECT registrazione_id FROM trascritto WHERE registrazione_id = :registrazioneId;

trovaRegistrazioniConTrascritto:
SELECT registrazione_id FROM trascritto;

inserisci:
INSERT INTO trascritto(registrazione_id, prossima_voce, prossimo_segmento)
VALUES (:registrazioneId, 0, :prossimoSegmento);

aggiornaContatori:
UPDATE trascritto SET prossimo_segmento = :prossimoSegmento
    WHERE registrazione_id = :registrazioneId;

-- ADR 0020: the trascritto row of a deleted Registrazione; its segmento and voce rows go first (voce FK is immediate).
elimina:
DELETE FROM trascritto WHERE registrazione_id = :registrazioneId;
