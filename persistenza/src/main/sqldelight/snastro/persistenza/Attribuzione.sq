-- Queries for `attribuzione` — schema in migrations/7.sqm (ADR 0034; ADR 0006 Amendment (a)).
-- Keyed by the Voce of the Incontro, (incontro_id, voce_id), as the domain's VoceRef (ADR 0033 §1): no join.

trova:
SELECT * FROM attribuzione WHERE incontro_id = :incontroId AND voce_id = :voceId;

trovaDiIncontro:
SELECT * FROM attribuzione WHERE incontro_id = :incontroId;

trovaDiParlante:
SELECT * FROM attribuzione WHERE parlante_id = :parlanteId;

inserisci:
INSERT INTO attribuzione(incontro_id, voce_id, progetto_id, parlante_id)
VALUES (:incontroId, :voceId, :progettoId, :parlanteId);

aggiornaParlante:
UPDATE attribuzione SET parlante_id = :parlanteId WHERE incontro_id = :incontroId AND voce_id = :voceId;

rimuovi:
DELETE FROM attribuzione WHERE incontro_id = :incontroId AND voce_id = :voceId;
