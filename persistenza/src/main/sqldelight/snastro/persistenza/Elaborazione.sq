-- Queries for `elaborazione` — schema in migrations/1.sqm + 2.sqm (numero_persone) + 3.sqm (ADR 0018) (ADR 0006 Amendment (a)).

trovaPerId:
SELECT * FROM elaborazione WHERE id = :id;

trovaDiRegistrazione:
SELECT * FROM elaborazione WHERE registrazione_id = :registrazioneId ORDER BY creata_alle, id;

trovaInAttesa:
SELECT * FROM elaborazione WHERE stato = 'in_attesa' ORDER BY creata_alle, id;

trovaInCorso:
SELECT * FROM elaborazione WHERE stato = 'in_corso' ORDER BY creata_alle, id;

inserisci:
INSERT INTO elaborazione(id, registrazione_id, stato, creata_alle, avviata_alle, motivo_fallimento, numero_persone)
VALUES (:id, :registrazioneId, :stato, :creataAlle, :avviataAlle, :motivoFallimento, :numeroPersone);

aggiornaStato:
UPDATE elaborazione SET stato = :stato, avviata_alle = :avviataAlle, motivo_fallimento = :motivoFallimento
    WHERE id = :id;

-- ADR 0018 Amendment (b): compare-and-delete of a never-started row (AnnullaElaborazione) — the only DELETE on
-- elaborazione. The `stato` condition lives in the SQL itself: 0 rows = started (or absent), never a stale read.
eliminaInAttesa:
DELETE FROM elaborazione WHERE id = :id AND stato = 'in_attesa';
