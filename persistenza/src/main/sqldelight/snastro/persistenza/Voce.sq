-- Entity: Voce, owned by Trascritto (INV-6). numero = the fixed "Voce n" label (never renumbered,
-- never reused, INV-12). The repository replaces the full set of rows per Registrazione on salva
-- (dev-architecture-app.md#repository), so no per-row update query is needed here.
CREATE TABLE voce (
    registrazione_id TEXT NOT NULL REFERENCES trascritto(registrazione_id),
    numero INTEGER NOT NULL,
    PRIMARY KEY (registrazione_id, numero)
);

trovaDiTrascritto:
SELECT * FROM voce WHERE registrazione_id = :registrazioneId ORDER BY numero;

inserisci:
INSERT INTO voce(registrazione_id, numero) VALUES (:registrazioneId, :numero);

eliminaDiRegistrazione:
DELETE FROM voce WHERE registrazione_id = :registrazioneId;
