inserisciSeAssente:
INSERT OR IGNORE INTO voce_incontro(incontro_id, numero)
SELECT incontro_id, :numero FROM registrazione WHERE id = :registrazioneId;

-- A Voce exists iff >= 1 Segmento in some Parte (INV-6): after the Parte's voce rows are replaced, drop the
-- Voci of its Incontro that no Parte of it has any more (their Parlanti FKs then fail the COMMIT, fail closed).
eliminaSenzaPresenza:
DELETE FROM voce_incontro
WHERE incontro_id = (SELECT incontro_id FROM registrazione WHERE id = :registrazioneId)
    AND NOT EXISTS (
        SELECT 1 FROM voce AS v INNER JOIN registrazione AS r ON r.id = v.registrazione_id
        WHERE r.incontro_id = voce_incontro.incontro_id AND v.numero = voce_incontro.numero
    );
