-- Queries for `registrazione` — schema in migrations/1.sqm + 7.sqm (ADR 0006 Amendment (a)).

trovaPerId:
SELECT * FROM registrazione WHERE id = :id;

-- In no guaranteed order: OrdineDelleRegistrazioni sorts them (ADR 0033 §7, no SQL ordering on the Parte-order columns).
trovaDelProgetto:
SELECT * FROM registrazione WHERE progetto_id = :progettoId;

-- ADR 0033 §1: the Parti of an Incontro (IncontroRepository.partiDi), in no guaranteed order (INV-I2 is the domain's).
trovaDiIncontro:
SELECT * FROM registrazione WHERE incontro_id = :incontroId;

-- ora_di_inizio: INV-I14, 'HH:MM:SS' or NULL (empty).
inserisci:
INSERT INTO registrazione(id, progetto_id, incontro_id, titolo, riferimento_audio, durata_ms, data_registrazione, aggiunta_alle, ora_di_inizio)
VALUES (:id, :progettoId, :incontroId, :titolo, :riferimentoAudio, :durataMs, :dataRegistrazione, :aggiuntaAlle, :oraDiInizio);

-- The columns that change after creation: titolo (AC-360), data_registrazione (INV-2), ora_di_inizio (INV-I14).
-- Never incontro_id: the trigger refuses any UPDATE naming it (D-0028).
aggiorna:
UPDATE registrazione SET titolo = :titolo, data_registrazione = :dataRegistrazione, ora_di_inizio = :oraDiInizio WHERE id = :id;

-- AC-326: single-column select — the repository never reconstitutes a Registrazione from this row.
titoliDelProgetto:
SELECT titolo FROM registrazione WHERE progetto_id = :progettoId;

-- ADR 0020: the only physical deletion of a Registrazione (EliminaRegistrazione). The elaborazione / trascritto FKs
-- are immediate: their rows must be gone first (the synchronous Trascrizione policy, before this DELETE).
elimina:
DELETE FROM registrazione WHERE id = :id;
