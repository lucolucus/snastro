-- Aggregate: Registrazione (tactical-model.md § Progetto + R6 titolo). progetto_id is set at
-- creation and never changes (INV-1); data_registrazione is the only mutable column (INV-2).
CREATE TABLE registrazione (
    id TEXT NOT NULL PRIMARY KEY,
    progetto_id TEXT NOT NULL REFERENCES progetto(id),
    titolo TEXT NOT NULL,
    riferimento_audio TEXT NOT NULL,
    durata_ms INTEGER NOT NULL,
    data_registrazione TEXT NOT NULL,
    aggiunta_alle INTEGER NOT NULL
);

CREATE INDEX registrazione_progetto ON registrazione(progetto_id);

trovaPerId:
SELECT * FROM registrazione WHERE id = :id;

trovaDelProgetto:
SELECT * FROM registrazione WHERE progetto_id = :progettoId
    ORDER BY data_registrazione DESC, aggiunta_alle DESC;

inserisci:
INSERT INTO registrazione(id, progetto_id, titolo, riferimento_audio, durata_ms, data_registrazione, aggiunta_alle)
VALUES (:id, :progettoId, :titolo, :riferimentoAudio, :durataMs, :dataRegistrazione, :aggiuntaAlle);

aggiornaData:
UPDATE registrazione SET data_registrazione = :dataRegistrazione WHERE id = :id;
