-- Queries for `registrazione` — schema in migrations/1.sqm (ADR 0006 Amendment (a)).

trovaPerId:
SELECT * FROM registrazione WHERE id = :id;

trovaDelProgetto:
SELECT * FROM registrazione WHERE progetto_id = :progettoId
    ORDER BY data_registrazione DESC, aggiunta_alle DESC;

inserisci:
INSERT INTO registrazione(id, progetto_id, titolo, riferimento_audio, durata_ms, data_registrazione, aggiunta_alle)
VALUES (:id, :progettoId, :titolo, :riferimentoAudio, :durataMs, :dataRegistrazione, :aggiuntaAlle);

aggiornaData:
UPDATE registrazione SET data_registrazione = :dataRegistrazione WHERE id = :id;
