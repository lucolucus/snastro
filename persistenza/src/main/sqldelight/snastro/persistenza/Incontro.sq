-- Queries for `incontro` — schema in migrations/7.sqm (ADR 0034, ADR 0006 Amendment (a)).
-- Written ONLY by the Progetto adapter (ADR 0034 §5).

-- OR IGNORE: the root is immutable (AC-I15), saving it again writes nothing; atomic, no check-then-insert.
inserisci:
INSERT OR IGNORE INTO incontro(id, progetto_id) VALUES (:id, :progettoId);

trovaPerId:
SELECT * FROM incontro WHERE id = :id;

trovaDelProgetto:
SELECT * FROM incontro WHERE progetto_id = :progettoId;

-- IncontroRepository.rimuovi: refused while a Parte is left by the immediate FK registrazione.incontro_id (INV-I1).
elimina:
DELETE FROM incontro WHERE id = :id;
