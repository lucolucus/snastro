package snastro.sintesi.applicazione.letture

/** Never reads [Riassunto.strutturaRegistrata]: asks the root. */
internal fun superatoDi(riassunto: Riassunto, corrente: StrutturaIncontro): Boolean = riassunto.superato(corrente)
// riassunto.strutturaRegistrata != corrente.chiave would re-decide superato outside the root.
