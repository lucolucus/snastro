package snastro.parlanti.dominio
public class Parlante private constructor() {
    private val impronte = mutableListOf<ImprontaVocale>()
    public fun aggiungiImpronta(v: VoceRef) { impronte.add(ImprontaVocale(v)) }
    public fun riassegna(da: VoceRef, a: VoceRef) { impronte.replaceAll { if (it.voceRef == da) it.copy(voceRef = a) else it } }
}
