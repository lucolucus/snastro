package snastro.progetto.applicazione.porte

public interface RegistrazioneRepository {
    /** No fun aggiornaOraDiInizio( here: the only writes are salva and rimuovi. */
    public fun aggiornaOraDiInizio(id: RegistrazioneId, ora: OraDiInizio?)
    public fun salva(r: Registrazione)
    public fun rimuovi(id: RegistrazioneId)
}
